# AronaClient 环境变量示例
# 复制此文件为 .env 并填入真实值
# 不要提交 .env 文件到版本控制

# DeepSeek API
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat

# OpenRouter API（可选）
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=deepseek/deepseek-chat

#  Provider 选择 (deepseek / openrouter)
PROVIDER=deepseek
